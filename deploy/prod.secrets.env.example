# Copy this file to `prod.secrets.env` (same folder) and fill in real values.
# `prod.secrets.env` is git-ignored so the real credentials never get committed.

# Railway Postgres PUBLIC proxy URL — find it in the Railway dashboard:
#   Postgres service -> Variables -> DATABASE_PUBLIC_URL
PROD_DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway
