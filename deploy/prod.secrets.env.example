# Copy this file to `prod.secrets.env` (same folder) and fill in real values.
# `prod.secrets.env` is git-ignored so the real credentials never get committed.

# Supabase Postgres — use the SESSION pooler URL (IPv4, port 5432), found in the
# Supabase dashboard: project -> Connect -> Session pooler.
# NOT the transaction pooler (port 6543): schema-per-school needs session-pinned
# search_path. NOT the direct db.<ref>.supabase.co host: IPv6-only.
PROD_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Only needed for the ONE-TIME Railway -> Supabase copy (deploy/copy-db-to-supabase.sh).
# Old Railway Postgres public proxy URL: Railway dashboard ->
#   Postgres service -> Variables -> DATABASE_PUBLIC_URL
RAILWAY_DATABASE_URL=postgresql://postgres:<password>@<host>.proxy.rlwy.net:<port>/railway
